local yapping = true
local GazeCooldown = 0.8

if not game:IsLoaded() then
    game.Loaded:Wait()
end

local guiName = "GazeUI"
local coreGui = cloneref(game:GetService("CoreGui")) or game:GetService("CoreGui")

if coreGui:FindFirstChild(guiName) then
    print("• GazeUI ya está ejecutado.")
    return
end

local function showFadeText(text)
    local fadeGui = Instance.new("ScreenGui")
    fadeGui.Name = "GazeNotification"
    fadeGui.Parent = coreGui

    local label = Instance.new("TextLabel")
    label.Parent = fadeGui
    label.Size = UDim2.new(0.5, 0, 0.2, 0)
    label.Position = UDim2.new(0.25, 0, 0.4, 0)
    label.BackgroundTransparency = 1
    label.TextTransparency = 1
    label.Text = text
    label.TextColor3 = Color3.fromRGB(0, 255, 255)
    label.TextScaled = true
    label.Font = Enum.Font.GothamBlack

    local TweenService = game:GetService("TweenService")

    local fadeIn = TweenService:Create(
        label,
        TweenInfo.new(GazeCooldown),
        {TextTransparency = 0}
    )

    fadeIn:Play()
    fadeIn.Completed:Wait()

    task.wait(GazeCooldown)

    local fadeOut = TweenService:Create(
        label,
        TweenInfo.new(GazeCooldown),
        {TextTransparency = 1}
    )

    fadeOut:Play()
    fadeOut.Completed:Wait()

    fadeGui:Destroy()
end

if yapping then
    showFadeText("Made By GazerHa")
    showFadeText("GazeUI cargado.")
    showFadeText("Versión sin funciones de chat.")
end

